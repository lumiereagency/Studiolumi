# Envio de e-mail do formulário de contato (Resend — https://resend.com)
# Sem essas três variáveis, o endpoint /api/contact continua funcionando
# normalmente, mas apenas loga o pedido no servidor em vez de enviar e-mail.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# URL pública do site, usada para gerar links absolutos (Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://studiolumi.company
